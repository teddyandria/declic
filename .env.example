# Backend (lu par backend/app/config.py)
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=sqlite:///./declic.db
# Ou le Postgres de docker compose (docker compose up -d db) :
# DATABASE_URL=postgresql://declic:declic@localhost:5433/declic

# LLM : seul le texte de la leçon (ou la photo) est envoyé, jamais le pseudo ni l'id
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_VISION_MODEL=gpt-4.1-mini

# Signature des jetons de connexion (≥ 32 caractères) :
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=
